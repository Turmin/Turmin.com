# turmin.com — www/.htaccess
#
# HTTPS redirect lives in the parent .htaccess (htdocs/.htaccess).
# No RewriteEngine here on purpose: rewrite rules in a child .htaccess
# replace the parent's rules instead of adding to them.

# Custom error pages
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 503 /errors/503.html
